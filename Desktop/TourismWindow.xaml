<Window x:Class="digital_heritage_preservation_app.TourismWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Serendib — Your world, your way">
 <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
 <Grid x:Name="Root" Loaded="LoadedWindow">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Padding="20,0,150,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE128;" FontSize="16"/><TextBlock Text="serendib" FontWeight="SemiBold"/><TextBlock Text="/  Your world, your way" Opacity="0.55" Margin="12,0,0,0"/></StackPanel></Grid>
  <Border Grid.Row="1" Margin="18,0,18,10" Padding="8" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><StackPanel x:Name="LocationTabs" Orientation="Horizontal" Spacing="8"/></ScrollViewer></Border>
  <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Auto" OpenPaneLength="224" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigate">
   <NavigationView.PaneHeader><StackPanel Margin="16,20,0,28" Spacing="4"><TextBlock Text="SERENDIB" FontSize="23" FontWeight="Bold" CharacterSpacing="160"/><TextBlock Text="YOUR NEXT CHAPTER" FontSize="10" CharacterSpacing="150" Opacity="0.55"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Discover" Tag="Discover" Icon="World" IsSelected="True"/>
    <NavigationViewItem Content="Saved places" Tag="Saved" Icon="Favorite"/>
    <NavigationViewItem Content="My trips" Tag="Trips" Icon="Calendar"/>
    <NavigationViewItem Content="Places wiki" Tag="Wiki" Icon="Read"/>
    <NavigationViewItemSeparator/>
    <NavigationViewItemHeader Content="CONNECTED TO CULTURE"/>
    <NavigationViewItem Content="Heritage archive" Tag="Archive" Icon="Library"/>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter><Border Padding="16" Margin="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="6"><TextBlock Text="Made for a slower journey." FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Your saved places and plans stay on this device." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/></StackPanel></Border></NavigationView.PaneFooter>
   <Grid Padding="28,8,28,20" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><StackPanel Spacing="4"><TextBlock x:Name="PageTitle" Text="Discover" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Small island. Endless possibilities." Opacity="0.65"/></StackPanel><Button Content="+ Plan a trip" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="CreateTrip"/></Grid>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True"/>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="22">
      <StackPanel x:Name="ExplorePanel" Spacing="20">
       <Border x:Name="Hero" CornerRadius="16" Height="260" Background="#183E39">
        <Grid>
         <Image x:Name="HeroImage" Source="ms-appx:///Assets/Travel/ella.jpg" Stretch="UniformToFill" Opacity="0.65"/>
         <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#ED123A34" Offset="0"/><GradientStop Color="#15123A34" Offset="1"/></LinearGradientBrush></Grid.Background></Grid>
         <StackPanel Margin="30" Spacing="12" VerticalAlignment="Center" MaxWidth="510" HorizontalAlignment="Left"><TextBlock Text="GO SOMEWHERE THAT STAYS WITH YOU" Foreground="#D8E9CC" FontSize="11" CharacterSpacing="150"/><TextBlock x:Name="HeroTitle" Text="A world of wonder." Foreground="White" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="HeroDescription" Text="Choose a country. Find your next chapter." Foreground="#E0EBE8" TextWrapping="Wrap"/><Button x:Name="HeroButton" Content="Explore featured place  →" Click="ExploreHill"/></StackPanel>
        </Grid>
       </Border>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBox x:Name="Search" PlaceholderText="Search destinations, regions or experiences" TextChanged="SearchChanged" AutomationProperties.Name="Search destinations"/><ComboBox x:Name="Category" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CategoryChanged" AutomationProperties.Name="Experience filter"><ComboBoxItem Content="All experiences" Tag="All experiences"/><ComboBoxItem Content="Heritage" Tag="Heritage"/><ComboBoxItem Content="Nature" Tag="Nature"/><ComboBoxItem Content="Coast" Tag="Coast"/><ComboBoxItem Content="Culture" Tag="Culture"/></ComboBox></Grid>
       <Grid><TextBlock x:Name="SectionTitle" Text="Find your kind of escape" FontSize="22" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12"><TextBlock x:Name="ResultCount" VerticalAlignment="Center" Opacity="0.6"/><Button Content="+ Add a place" Click="AddPlace"/></StackPanel></Grid>
       <TextBlock x:Name="EmptyPlaces" Text="No places found. Try another search or save a destination from Discover." Visibility="Collapsed" TextWrapping="Wrap"/>
       <GridView x:Name="Places" IsItemClickEnabled="True" ItemClick="OpenPlace" SelectionMode="None" HorizontalAlignment="Stretch">
        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
        <GridView.ItemTemplate><DataTemplate><Border Width="288" Margin="0,0,8,14" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><Grid Height="158" Background="#315A50"><FontIcon Glyph="&#xE128;" Foreground="#9DBFB0" FontSize="40"/><Image Source="{Binding Image}" Stretch="UniformToFill"/></Grid><StackPanel Padding="16" Spacing="7"><TextBlock Text="{Binding Category}" FontSize="11" CharacterSpacing="100" Opacity="0.65"/><TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Region}" Opacity="0.6"/><TextBlock Text="{Binding Highlight}" TextWrapping="Wrap" FontSize="12" MinHeight="34"/><TextBlock Text="{Binding ExploreLabel}" FontWeight="SemiBold" FontSize="12"/></StackPanel></StackPanel></Border></DataTemplate></GridView.ItemTemplate>
       </GridView>
      </StackPanel>
      <StackPanel x:Name="WikiPanel" Visibility="Collapsed" Spacing="14">
       <TextBlock Text="Learn the story behind a place" FontSize="24" FontWeight="SemiBold"/>
       <TextBlock Text="Browse destination notes offline, or search Wikipedia worldwide and read here. Wikipedia search uses your app language and needs internet." TextWrapping="Wrap" Opacity="0.7"/>
       <AutoSuggestBox x:Name="WikiSearch" PlaceholderText="Search a place, landmark or region" QueryIcon="Find" TextChanged="WikiSearchChanged" QuerySubmitted="WikiQuerySubmitted" AutomationProperties.Name="Search places wiki"/>
       <Button Content="Search Wikipedia" Click="SearchWikipedia"/>
       <TextBlock x:Name="WikiCount" TextWrapping="Wrap"/>
       <ListView x:Name="WikiPlaces" MaxHeight="230" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OpenWikiPlace" AutomationProperties.Name="Offline destination notes">
        <ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Opacity="0.65"/><TextBlock Text="{Binding Highlight}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <Border x:Name="WikiNotes" Visibility="Collapsed" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock x:Name="WikiPlaceTitle" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="WikiPlaceFacts" Opacity="0.7"/><TextBlock x:Name="WikiPlaceDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Read on Wikipedia" Click="ReadWikiPlace"/><Button Content="Save or plan a visit" Click="PlanWikiPlace"/></StackPanel><TextBlock Text="Source: your app’s destination catalog. Custom notes reflect your edits." FontSize="12" TextWrapping="Wrap" Opacity="0.6"/></StackPanel></Border>
       <StackPanel x:Name="WikiReaderPanel" Visibility="Collapsed" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="WikiBack" Content="Back" IsEnabled="False" Click="WikiGoBack"/><Button Content="Retry" Click="WikiRetry"/><Button Content="Close article" Click="CloseWikiReader"/></StackPanel>
        <TextBlock x:Name="WikiSource" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
        <ProgressBar x:Name="WikiLoading" IsIndeterminate="True" Visibility="Collapsed"/>
        <InfoBar x:Name="WikiError" Severity="Warning" IsOpen="False" IsClosable="True"/>
        <WebView2 x:Name="WikiBrowser" Height="560" NavigationStarting="WikiNavigationStarting" NavigationCompleted="WikiNavigationCompleted"/>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="TripsPanel" Visibility="Collapsed" Spacing="18"><TextBlock Text="Make room for the memorable." FontSize="22"/><TextBlock x:Name="EmptyTrips" Text="Your next adventure starts with a plan. Create a trip, then add destinations to each day." TextWrapping="Wrap" Opacity="0.65"/><ListView x:Name="TripsList" SelectionChanged="SelectTrip"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="12" Spacing="6"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Opacity="0.65"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="ItineraryPanel" Visibility="Collapsed" Spacing="12"><Grid><TextBlock x:Name="TripTitle" FontSize="24"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="Edit trip" Click="EditTrip"/><Button Content="Export itinerary" Click="ExportTrip"/><Button Content="Delete" Click="DeleteTrip"/></StackPanel></Grid><TextBlock Text="Add places from Discover. Select a stop below to edit its day or notes." Opacity="0.6" TextWrapping="Wrap"/><StackPanel x:Name="Stops" Spacing="8"/></StackPanel></StackPanel>
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="20"><TextBlock Text="Make yourself at home." FontSize="22"/><ComboBox x:Name="LanguageChoice" Header="App language" SelectionChanged="LanguageChanged" Width="300"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="ja" Content="日本語"/><ComboBoxItem Tag="ko" Content="한국어"/><ComboBoxItem Tag="ru" Content="Русский"/></ComboBox><TextBlock Text="Destination descriptions and your own notes keep their original language." TextWrapping="Wrap" Opacity="0.6"/><ComboBox x:Name="HomeChoice" Header="Home country / Local" IsEditable="True" Width="300"/><Button Content="Apply home country" Click="SaveHome"/><TextBlock Text="Local uses your chosen home country, not GPS. Your last location tab is remembered." TextWrapping="Wrap" Opacity="0.6"/><ComboBox x:Name="ThemeChoice" Header="Appearance" SelectionChanged="ThemeChanged" Width="260"><ComboBoxItem Content="Use system setting" Tag="Use system setting"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox><Border Padding="22" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Your journey, on your device" FontSize="20"/><TextBlock Text="Trips and saved places work offline. Destination photography is bundled with the app. Maps open in your browser. This is a personal travel planner; bookings and live availability are not provided." TextWrapping="Wrap" Opacity="0.7"/><Button Content="Export travel backup" Click="ExportBackup"/><Button Content="Restore travel backup" Click="ImportBackup"/><Button Content="Photo credits" Click="ShowCredits"/></StackPanel></Border></StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </NavigationView>
 </Grid>
</Window>



