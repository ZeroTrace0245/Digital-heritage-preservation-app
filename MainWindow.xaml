<Window x:Class="digital_heritage_preservation_app.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Heritage • Community archive">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <NavigationView x:Name="Navigation" IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="Navigate">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="All collections" Tag="All" Icon="Home" IsSelected="True" />
   <NavigationViewItem Content="Stories" Tag="Story" Icon="Read" />
   <NavigationViewItem Content="Artifacts" Tag="Artifact" Icon="Pictures" />
   <NavigationViewItem Content="Languages" Tag="Language" Icon="World" />
   <NavigationViewItem Content="Events" Tag="Event" Icon="Calendar" />
   <NavigationViewItem Content="Community" Tag="Community" Icon="Contact" />
   <NavigationViewItem Content="Favorites" Tag="Favorites" Icon="Favorite" />
  </NavigationView.MenuItems>
  <Grid Padding="28" RowSpacing="16" Loaded="OnLoaded">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Spacing="6"><TextBlock Text="HERITAGE / COMMUNITY ARCHIVE" FontSize="12" CharacterSpacing="150"/><TextBlock x:Name="Heading" Text="All collections" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="Stats" Text="Preserve the stories that connect us." TextWrapping="Wrap"/></StackPanel>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
    <Button Content="+ Add record" Click="Add" Style="{StaticResource AccentButtonStyle}"/>
    <Button Content="Export backup" Click="Export"/><Button Content="Import backup" Click="Import"/>
   </StackPanel>
   <StackPanel Grid.Row="2" Spacing="8">
    <TextBox x:Name="Search" PlaceholderText="Search titles, culture, location, tags or descriptions" TextChanged="FilterChanged"/>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
   </StackPanel>
   <Grid Grid.Row="3" ColumnSpacing="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid><ListView x:Name="Records" SelectionChanged="SelectRecord">
     <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,10" Spacing="5"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Opacity="0.7" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView><TextBlock x:Name="Empty" Text="No matching records. Add a record or change your search." TextWrapping="Wrap" Margin="12" Visibility="Collapsed"/></Grid>
    <ScrollViewer Grid.Column="1"><StackPanel Spacing="14">
     <TextBlock Text="Record details" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <TextBlock x:Name="DetailTitle" Text="Select a record to explore its history." FontSize="24" TextWrapping="Wrap"/>
     <TextBlock x:Name="DetailMeta" Opacity="0.7" TextWrapping="Wrap"/>
     <TextBlock x:Name="DetailBody" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><Button Content="Edit" Click="Edit"/><Button x:Name="FavoriteButton" Content="Favorite" Click="Favorite"/><Button Content="Delete" Click="Delete"/></StackPanel>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
 </NavigationView>
</Window>
