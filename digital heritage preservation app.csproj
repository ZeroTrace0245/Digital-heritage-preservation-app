<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Title>Lorevia</Title>
    <Product>Lorevia</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\Lorevia.ico</ApplicationIcon>
    <Description>Discover places, preserve stories and plan your journey.</Description>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>digital_heritage_preservation_app</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Travel\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Lorevia.ico;PRIVACY.md;CONTENT-CREDITS.md;LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Controllers\**;Data\**;Models\**;Program.cs" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>
  <Target Name="PublishLoreviaXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <LoreviaXamlResources Include="$(TargetDir)**\*.xbf;$(TargetDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(LoreviaXamlResources)" DestinationFiles="@(LoreviaXamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
